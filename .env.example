# RemediAide — contoh variabel lingkungan. Salin ke .env.local untuk dev; JANGAN commit file berisi nilai asli.
# PostgreSQL (pgbouncer di produksi; port langsung untuk migrasi)
DATABASE_URL=postgresql://postgres:dev@localhost:5432/remediaide
DIRECT_URL=postgresql://postgres:dev@localhost:5432/remediaide
# NextAuth v5
AUTH_SECRET=ganti-dengan-string-acak-panjang
AUTH_URL=http://localhost:3000
# Redis opsional (worker BullMQ menjadi no-op tanpa REDIS_URL)
REDIS_URL=
# RemediAide 2.0 — layanan ML (ml/service). Kosongkan untuk hanya memakai aturan v1.
ML_SERVICE_URL=http://localhost:8000
# Opsional: token baca bila layanan ML ada di Hugging Face Space privat (dikirim sebagai Authorization: Bearer)
ML_SERVICE_TOKEN=
ML_TIMEOUT_MS=4000
# Garam HMAC untuk student_key ke layanan ML dan ekspor riset (wajib bila ML_SERVICE_URL diisi)
RESEARCH_EXPORT_SALT=ganti-dengan-string-acak-panjang
JUDGE_EMAILS=""
